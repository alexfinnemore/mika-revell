{
  "name": "mika-revell",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev --ignore-lock\"",
    "build": "npm run images:dimensions && tinacms build --skip-cloud-checks && npm run check:schema && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "test:update-screenshots": "playwright test --update-snapshots",
    "images:dimensions": "node scripts/image-dimensions.mjs",
    "images:import": "node --env-file-if-exists=.env scripts/import-images.mjs",
    "astro": "astro",
    "check:secrets": "gitleaks git . --log-opts=origin/master..HEAD --redact --no-banner",
    "check:schema": "node scripts/check-schema.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tinacms/cli": "^3.1.0",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "tinacms": "^3.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@vercel/blob": "^2.8.0",
    "probe-image-size": "^7.4.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  }
}
