---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageCard from '../components/ImageCard.astro';
import { getHomepageImages } from '../lib/content';

const images = await getHomepageImages();
---

<BaseLayout ogImage={images[0]?.image}>
  <h1 class="sr-only">Mika Revell</h1>
  <section class="space-y-4 sm:space-y-6 lg:space-y-8">
    {images.map((item, i) => (
      <ImageCard
        image={item.image}
        alt={item.alt || 'Artwork by Mika Revell'}
        href={item.href}
        priority={i === 0}
      />
    ))}
  </section>
</BaseLayout>
