---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getPublicWorks } from '../../lib/content';

const works = await getPublicWorks();
---

<BaseLayout title="Work" ogImage={works[0]?.data.coverImage}>
  <h1 class="sr-only">Work</h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
    {works.map((work, i) => (
      <article class="group">
        <a href={`/work/${work.id}/`} class="block">
          <div class="overflow-hidden bg-surface mb-4">
            <ResponsiveImage
              src={work.data.coverImage}
              alt=""
              sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 440px"
              class="w-full aspect-[4/3] object-cover transition-transform duration-300 ease-out group-hover:scale-[1.02]"
              priority={i < 2}
              lockAspect={false}
            />
          </div>
          <h2 class="text-lg font-normal group-hover:text-accent transition-colors">
            {work.data.title}
          </h2>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>
