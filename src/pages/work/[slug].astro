---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getPublicWorks, getWorkArtworks } from '../../lib/content';
import { paragraphs, summary } from '../../lib/text';

export async function getStaticPaths() {
  const works = await getPublicWorks();
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { title, subtitle, year, description, coverImage } = work.data;
const artworks = await getWorkArtworks(work);
const IMAGE_SIZES = '(max-width: 719px) 100vw, 672px';
---

<BaseLayout
  title={title}
  description={description ? summary(description) : undefined}
  ogImage={coverImage}
>
  <header class="mb-12 max-w-2xl">
    <h1 class="text-2xl lg:text-3xl font-semibold mb-2">{title}</h1>
    {(subtitle || year) && (
      <p class="text-text-muted">
        {subtitle && <span class="italic">{subtitle}</span>}
        {subtitle && year && <span> | </span>}
        {year}
      </p>
    )}
    {description && (
      <div class="mt-4 text-text-muted space-y-4">
        {paragraphs(description).map((p) => <p>{p}</p>)}
      </div>
    )}
  </header>

  <section class="space-y-8 lg:space-y-12 max-w-2xl">
    {artworks.map((artwork, i) => {
      const { title, year, medium, dimensions, description, image } = artwork.data;
      const details = [year, medium, dimensions].filter(Boolean);
      return (
        <figure id={artwork.id} class="artwork scroll-mt-20 relative group bg-surface" tabindex="0">
          <ResponsiveImage src={image} alt={title} sizes={IMAGE_SIZES} class="w-full h-auto" priority={i === 0} />
          <figcaption class="artwork-caption absolute bottom-0 left-0 right-0 bg-black/70 text-white p-4 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-200">
            <h2 class="text-lg">{title}</h2>
            {details.map((d) => <p class="text-sm opacity-80">{d}</p>)}
            {description && <p class="text-sm opacity-80 mt-2">{description}</p>}
          </figcaption>
        </figure>
      );
    })}

    {artworks.length === 0 && (
      <div class="bg-surface">
        <ResponsiveImage src={coverImage} alt={title} sizes={IMAGE_SIZES} class="w-full h-auto" priority />
      </div>
    )}
  </section>
</BaseLayout>

<script>
  // On touch screens there is no hover, so a tap shows or hides an artwork's caption.
  const captions = () => document.querySelectorAll<HTMLElement>('.artwork-caption');
  const hideAll = () => captions().forEach((c) => c.classList.remove('opacity-100'));

  document.addEventListener('click', (e) => {
    if (!matchMedia('(hover: none)').matches) return;
    const artwork = (e.target as Element).closest('.artwork');
    const caption = artwork?.querySelector<HTMLElement>('.artwork-caption');
    const wasShown = caption?.classList.contains('opacity-100');
    hideAll();
    if (caption && !wasShown) caption.classList.add('opacity-100');
  });
</script>
