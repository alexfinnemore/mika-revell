---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicWriting } from '../../lib/content';
import { formatMonth } from '../../lib/text';

// Only build /writing/ when there is writing to list.
export async function getStaticPaths() {
  const pieces = await getPublicWriting();
  return pieces.length ? [{ params: { index: undefined }, props: { pieces } }] : [];
}

const { pieces } = Astro.props;
---

<BaseLayout title="Writing">
  <h1 class="sr-only">Writing</h1>
  <ul class="space-y-8 max-w-2xl">
    {pieces.map((piece) => (
      <li>
        <a href={`/writing/${piece.id}/`} class="group block">
          <h2 class="text-lg font-normal group-hover:text-accent transition-colors">{piece.data.title}</h2>
          {(piece.data.subtitle || piece.data.date) && (
            <p class="text-sm text-text-muted">
              {[piece.data.subtitle, piece.data.date && formatMonth(piece.data.date)].filter(Boolean).join(' | ')}
            </p>
          )}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
