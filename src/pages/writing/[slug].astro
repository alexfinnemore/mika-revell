---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublicWriting } from '../../lib/content';
import { summary } from '../../lib/text';

export async function getStaticPaths() {
  const pieces = await getPublicWriting();
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { title, subtitle, date } = piece.data;
const { Content } = await render(piece);
const formatDate = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---

<BaseLayout title={title} description={piece.body ? summary(piece.body.replace(/[#*_>`]/g, '')) : undefined}>
  <article class="max-w-2xl">
    <header class="mb-8">
      <h1 class="text-2xl lg:text-3xl font-semibold mb-2">{title}</h1>
      {(subtitle || date) && (
        <p class="text-text-muted">
          {subtitle && <span class="italic">{subtitle}</span>}
          {subtitle && date && <span> | </span>}
          {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
        </p>
      )}
    </header>
    <div class="writing text-text-muted">
      <Content />
    </div>
  </article>
</BaseLayout>
