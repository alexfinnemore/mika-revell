---
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  image: string;
  alt: string;
  href?: string;
  priority?: boolean;
}

const { image, alt, href, priority } = Astro.props;
const Wrapper = href ? 'a' : 'div';
---

<article class="group">
  <Wrapper href={href} class="block overflow-hidden bg-surface">
    <ResponsiveImage
      src={image}
      alt={alt}
      sizes="(max-width: 1023px) 100vw, 900px"
      class="w-full h-auto transition-transform duration-300 ease-out group-hover:scale-[1.02]"
      priority={priority}
    />
  </Wrapper>
</article>
