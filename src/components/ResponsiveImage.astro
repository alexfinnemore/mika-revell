---
// One image, resized by Vercel and sized so the page doesn't jump while it loads.
import { imageUrl, imageSrcset, imageSize } from '../lib/image';

interface Props {
  src: string;
  alt: string;
  /** How wide the image is drawn, for the browser to pick a size. */
  sizes: string;
  class?: string;
  /** The first image on a page should load straight away; the rest can wait. */
  priority?: boolean;
  /**
   * Keep the box at the original photo's proportions even after a resized copy
   * loads (whose proportions can differ by a pixel), so nothing shifts. Turn off
   * when the class sets its own aspect ratio.
   */
  lockAspect?: boolean;
}

const { src, alt, sizes, class: className, priority = false, lockAspect = true } = Astro.props;
const size = imageSize(src);
const style = lockAspect && size ? `aspect-ratio: ${size.width} / ${size.height}` : undefined;
---

<img
  src={imageUrl(src, 1280)}
  srcset={imageSrcset(src)}
  sizes={sizes}
  alt={alt}
  width={size?.width}
  height={size?.height}
  class={className}
  style={style}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
/>
